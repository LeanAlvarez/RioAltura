# Copiá este archivo a .env.local o, mejor, corré scripts/wt-env.sh
# que lo genera con puertos únicos para el worktree.

# --- Puertos del worktree (los recalcula scripts/wt-env.sh) ---
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
COMPOSE_PROJECT_NAME=rioaltura-local

# --- Postgres ---
POSTGRES_USER=rioaltura
POSTGRES_PASSWORD=rioaltura
POSTGRES_DB=rioaltura
# Host de la base visto desde procesos corriendo en tu máquina (fuera de Docker).
# Dentro del compose se sobreescribe a "db".
DB_HOST=localhost
# Opcional: si está definida, tiene prioridad sobre las partes de arriba.
DATABASE_URL=

# --- API / worker ---
LOG_LEVEL=INFO

# --- Worker: Google Flood Forecasting (solo el worker la lee; nunca al frontend) ---
FLOODS_API_KEY=

# --- Worker: Telegram (spec 011, solo el worker; mismo tratamiento que FLOODS_API_KEY) ---
# Token del bot (@RioUruguayNotificaBot). Nunca a logs, fixtures ni al frontend.
TELEGRAM_BOT_TOKEN=
# Usuario del canal público (@RioUruguayNotifica). No es secreto: a diferencia
# del token, puede vivir acá y en los links de la app.
TELEGRAM_CANAL_ID=
# S4, interruptor de corte: en "false" no se publica nada (el resto del worker sigue igual).
TELEGRAM_PUBLICACION_ACTIVA=true
# S3, tope duro de mensajes por día (canal + todos los suscriptores).
TELEGRAM_TOPE_MENSAJES_DIA=100
# Opcional: link que se agrega al pie de cada mensaje. Vacío = sin link.
TELEGRAM_APP_URL=
# Horarios según urgencia (spec 014). Hora local de Buenos Aires (UTC-3 fijo).
# A2 (estado diario): hora fija en la que sale, no la primera corrida del día.
TELEGRAM_HORA_ESTADO_DIARIO=8
# A1/A3 (cambio de nivel de aviso, por pronóstico): ventana diurna; de noche espera a la mañana.
# B1/B2 (umbral propio, medición real) no usan esta ventana: se publican siempre.
TELEGRAM_VENTANA_DIURNA_INICIO_HORA=8
TELEGRAM_VENTANA_DIURNA_FIN_HORA=21

# --- Frontend ---
# URL base de la API. Vacío = mismo origen, vía proxy /api (dev server y nginx).
VITE_API_URL=
